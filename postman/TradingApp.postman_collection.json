          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const res = pm.response.json();",
                "if (res.success && res.data) {",
                "  pm.environment.set('accessToken', res.data.accessToken);",
                "  pm.environment.set('refreshToken', res.data.refreshToken);",
                "}",
                "pm.test('Status 200 or 400', () => pm.expect([200,400]).to.include(pm.response.code));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"swagger@trading.local\",\n  \"password\": \"Passw0rd!\",\n  \"firstName\": \"Swagger\",\n  \"lastName\": \"User\"\n}",
