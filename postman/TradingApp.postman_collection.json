        {
          "name": "Scan All",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const res = pm.response.json();",
                "if (res.success && res.data) {",
                "  const d = res.data;",
                "  console.log(`Scanned: ${d.totalScanned}`);",
                "  console.log(`Güçlü Yükseliş: ${d.strongBullish}, Yükseliş: ${d.bullish}, Nötr: ${d.neutral}, Düşüş: ${d.bearish}, Güçlü Düşüş: ${d.strongBearish}`);",
                "  console.log('--- TOP ---');",
                "  d.top.forEach(t => console.log(`  ${t.symbol}: ${t.ceilingScore} (${t.ceilingCategory}) rsi=${t.rsi14} vol=${t.volumeRatio}`));",
                "  console.log('--- BOTTOM ---');",
                "  d.bottom.forEach(t => console.log(`  ${t.symbol}: ${t.ceilingScore} (${t.ceilingCategory})`));",
                "}"
              ]
            }
          }],
          "request": {
