# ============================================================
# TradingApp — Örnek Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=tradingdb
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_dev_pwd

# --- Redis ---
REDIS_PASSWORD=bist_dev_pwd_123

# --- JWT ---
# Üretimde mutlaka değiştirin: openssl rand -base64 48
JWT_KEY=dev-only-super-secret-key-change-me-please-1234567890
JWT_ISSUER=TradingApp
JWT_AUDIENCE=TradingApp.Client

# --- BIST Data Service ---
# Container içinden host'a erişim için host.docker.internal
BIST_DATA_SERVICE_URL=http://host.docker.internal:8000

# --- Market Data ---
# Yahoo | Mock | BistDataService
MARKET_DATA_PROVIDER=Yahoo
FALLBACK_TO_MOCK=true

# --- Frontend ---
# Dev ortamı
VITE_API_URL=http://localhost:5000